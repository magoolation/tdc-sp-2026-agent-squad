# ---------------------------------------------------------------------------
# EditorConfig — TDC São Paulo 2026 · Agent Squad
#
# Baseline: the .NET Foundation / dotnet-runtime conventions, tightened for the
# engineering rules documented in docs/engineering-rules.md.
#
# Anything marked `= error` here is a BUILD BREAK (TreatWarningsAsErrors is on
# in Directory.Build.props). The autonomous coding agents run `dotnet format
# --verify-no-changes` before opening a pull request, so this file is the
# single source of truth for "what does correct code look like here".
# ---------------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{json,json5,yml,yaml,js,ts,css,scss,html,csx,ps1,psm1}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf

[*.{csproj,vbproj,fsproj,props,targets,slnx,config,nuspec,resx,xml,bicep,bicepparam}]
indent_size = 2

# ===========================================================================
# C#
# ===========================================================================
[*.cs]
indent_size = 4

# --- using directives ------------------------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error

# --- modern C# style (enforced) -------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:error
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion
csharp_style_prefer_utf8_string_literals = true:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# `var` — explicit types read better in agent-generated code reviews.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- language rules --------------------------------------------------------
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_namespace_match_folder = true:warning

# --- new-line / spacing ----------------------------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ===========================================================================
# Naming — .NET Framework Design Guidelines
# ===========================================================================
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.i_prefixed.capitalization = pascal_case
dotnet_naming_style.i_prefixed.required_prefix = I

dotnet_naming_style.t_prefixed.capitalization = pascal_case
dotnet_naming_style.t_prefixed.required_prefix = T

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.s_underscore_camel.capitalization = camel_case
dotnet_naming_style.s_underscore_camel.required_prefix = s_

dotnet_naming_style.all_upper.capitalization = all_upper
dotnet_naming_style.all_upper.word_separator = _

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_are_i_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_prefixed.style = i_prefixed
dotnet_naming_rule.interfaces_are_i_prefixed.severity = error

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters_are_t_prefixed.symbols = type_parameters
dotnet_naming_rule.type_parameters_are_t_prefixed.style = t_prefixed
dotnet_naming_rule.type_parameters_are_t_prefixed.severity = error

dotnet_naming_symbols.public_members.applicable_kinds = class,struct,enum,property,method,event,delegate,namespace
dotnet_naming_symbols.public_members.applicable_accessibilities = *
dotnet_naming_rule.public_members_are_pascal.symbols = public_members
dotnet_naming_rule.public_members_are_pascal.style = pascal_case
dotnet_naming_rule.public_members_are_pascal.severity = error

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal_case
dotnet_naming_rule.constants_are_pascal.severity = error

# `static readonly` data is effectively a constant, so it reads as one: PascalCase.
# This rule must precede the `s_` rule below, because the first matching rule wins.
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = private,private_protected
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_rule.static_readonly_fields_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal.severity = silent

# The `s_` prefix is reserved for MUTABLE shared state, which is the thing worth flagging
# at a glance. Applying it to immutable data would dilute exactly that signal.
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = private,private_protected
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_rule.static_fields_are_s_underscore.symbols = static_fields
dotnet_naming_rule.static_fields_are_s_underscore.style = s_underscore_camel
dotnet_naming_rule.static_fields_are_s_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private,private_protected
dotnet_naming_rule.private_fields_are_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_are_underscore.severity = warning

# Local constants are PascalCase, matching the .NET runtime's own convention.
# This rule must precede the parameter/local rule below: the first matching rule wins.
dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const
dotnet_naming_rule.local_constants_are_pascal.symbols = local_constants
dotnet_naming_rule.local_constants_are_pascal.style = pascal_case
dotnet_naming_rule.local_constants_are_pascal.severity = silent

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter,local
dotnet_naming_rule.parameters_are_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_are_camel.style = camel_case
dotnet_naming_rule.parameters_are_camel.severity = suggestion

# ===========================================================================
# Analyzer severities that the CI gate depends on
# ===========================================================================
# --- Security (CA2100/CA3xxx/CA5xxx) — never downgrade these --------------
dotnet_diagnostic.CA2100.severity = error   # SQL injection via string concat
dotnet_diagnostic.CA2109.severity = error   # visible event handlers
dotnet_diagnostic.CA2119.severity = error   # seal methods satisfying private ifaces
dotnet_diagnostic.CA2300.severity = error   # insecure BinaryFormatter deserialization
dotnet_diagnostic.CA2301.severity = error
dotnet_diagnostic.CA2302.severity = error
dotnet_diagnostic.CA2305.severity = error
dotnet_diagnostic.CA2310.severity = error
dotnet_diagnostic.CA2311.severity = error
dotnet_diagnostic.CA2312.severity = error
dotnet_diagnostic.CA2315.severity = error
dotnet_diagnostic.CA2321.severity = error
dotnet_diagnostic.CA2322.severity = error
dotnet_diagnostic.CA2326.severity = error
dotnet_diagnostic.CA2327.severity = error
dotnet_diagnostic.CA2328.severity = error
dotnet_diagnostic.CA2329.severity = error
dotnet_diagnostic.CA2330.severity = error
dotnet_diagnostic.CA3001.severity = error   # SQL injection
dotnet_diagnostic.CA3002.severity = error   # XSS
dotnet_diagnostic.CA3003.severity = error   # file path injection
dotnet_diagnostic.CA3004.severity = error   # information disclosure
dotnet_diagnostic.CA3006.severity = error   # process command injection
dotnet_diagnostic.CA3007.severity = error   # open redirect
dotnet_diagnostic.CA3012.severity = error   # regex injection
dotnet_diagnostic.CA3061.severity = error   # DTD processing
dotnet_diagnostic.CA3075.severity = error   # insecure DTD
dotnet_diagnostic.CA3076.severity = error   # insecure XSLT
dotnet_diagnostic.CA3077.severity = error
dotnet_diagnostic.CA3147.severity = error   # missing ValidateAntiForgeryToken
dotnet_diagnostic.CA5350.severity = error   # weak crypto
dotnet_diagnostic.CA5351.severity = error   # broken crypto
dotnet_diagnostic.CA5358.severity = error   # unsafe cipher modes
dotnet_diagnostic.CA5359.severity = error   # do not disable cert validation
dotnet_diagnostic.CA5360.severity = error
dotnet_diagnostic.CA5361.severity = error
dotnet_diagnostic.CA5362.severity = error
dotnet_diagnostic.CA5363.severity = error
dotnet_diagnostic.CA5364.severity = error   # deprecated security protocols
dotnet_diagnostic.CA5365.severity = error
dotnet_diagnostic.CA5366.severity = error
dotnet_diagnostic.CA5367.severity = error
dotnet_diagnostic.CA5368.severity = error
dotnet_diagnostic.CA5369.severity = error
dotnet_diagnostic.CA5370.severity = error
dotnet_diagnostic.CA5371.severity = error
dotnet_diagnostic.CA5372.severity = error
dotnet_diagnostic.CA5373.severity = error
dotnet_diagnostic.CA5374.severity = error
dotnet_diagnostic.CA5375.severity = error
dotnet_diagnostic.CA5376.severity = error
dotnet_diagnostic.CA5377.severity = error
dotnet_diagnostic.CA5378.severity = error
dotnet_diagnostic.CA5379.severity = error
dotnet_diagnostic.CA5380.severity = error
dotnet_diagnostic.CA5381.severity = error
dotnet_diagnostic.CA5382.severity = error
dotnet_diagnostic.CA5383.severity = error
dotnet_diagnostic.CA5384.severity = error
dotnet_diagnostic.CA5385.severity = error
dotnet_diagnostic.CA5386.severity = error
dotnet_diagnostic.CA5387.severity = error
dotnet_diagnostic.CA5388.severity = error
dotnet_diagnostic.CA5389.severity = error   # zip path traversal
dotnet_diagnostic.CA5390.severity = error   # hard-coded encryption key
dotnet_diagnostic.CA5391.severity = error
dotnet_diagnostic.CA5392.severity = error
dotnet_diagnostic.CA5393.severity = error
dotnet_diagnostic.CA5394.severity = warning # insecure randomness
dotnet_diagnostic.CA5395.severity = error
dotnet_diagnostic.CA5396.severity = error
dotnet_diagnostic.CA5397.severity = error
dotnet_diagnostic.CA5398.severity = error
dotnet_diagnostic.CA5399.severity = error
dotnet_diagnostic.CA5400.severity = error
dotnet_diagnostic.CA5401.severity = error
dotnet_diagnostic.CA5402.severity = error
dotnet_diagnostic.CA5403.severity = error
dotnet_diagnostic.CA5404.severity = error
dotnet_diagnostic.CA5405.severity = error

# --- Reliability / async ---------------------------------------------------
dotnet_diagnostic.CA2007.severity = none    # ConfigureAwait: not needed (no SynchronizationContext in our hosts)
dotnet_diagnostic.CA2016.severity = error   # forward CancellationToken
dotnet_diagnostic.CA1068.severity = error   # CancellationToken must be last
dotnet_diagnostic.CA2012.severity = error   # use ValueTask correctly
dotnet_diagnostic.CA2000.severity = warning # dispose before losing scope
dotnet_diagnostic.CA1849.severity = warning # call async methods in async context
dotnet_diagnostic.VSTHRD002.severity = none

# --- Usage / design --------------------------------------------------------
dotnet_diagnostic.CA1062.severity = none    # nullable reference types cover this
dotnet_diagnostic.CA1303.severity = none    # literals: this app is not localized
dotnet_diagnostic.CA1848.severity = none    # LoggerMessage delegates: too noisy for a sample
dotnet_diagnostic.CA1515.severity = none    # public types in an app assembly
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA1716.severity = none

# CA1711 reserves the `Stream` suffix for System.IO.Stream. In this domain "event stream"
# is the precise term for the run's event sequence, so the suffix is allowed here via the
# rule's own configuration API rather than by suppressing the rule.
dotnet_code_quality.CA1711.allowed_suffixes = Stream

# --- Code-style rules run as part of the build -----------------------------
dotnet_diagnostic.IDE0005.severity = error  # unnecessary using
dotnet_diagnostic.IDE0055.severity = error  # formatting (dotnet format)
dotnet_diagnostic.IDE0161.severity = error  # file-scoped namespaces
dotnet_diagnostic.IDE0011.severity = error  # braces required
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0090.severity = suggestion

# IDE0060 (unused parameter) cannot tell an accidental leftover from a parameter an
# external delegate contract requires — the Copilot SDK's permission callback, for one.
# Kept visible as a suggestion rather than enforced as a build break.
dotnet_diagnostic.IDE0060.severity = suggestion

# ===========================================================================
# Test projects — a few rules relax where they only add noise
# ===========================================================================
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none    # Method_Should_DoThing naming
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none    # constant arrays as arguments
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.IDE0058.severity = none

# ===========================================================================
# Generated code
# ===========================================================================
[*.{g,generated,designer}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
