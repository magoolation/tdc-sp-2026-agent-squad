<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Only nuget.org. A deliberately explicit, minimal feed list is a supply-chain
    control (SEC-011): <clear/> removes any machine-level feed that could silently
    shadow a package with a look-alike from an untrusted source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value="%UserProfile%\.nuget\packages" />
  </config>

</configuration>
